# Application
APP_NAME="ERP AI Copilot"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=erp_copilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# LLM Providers (Configure at least one)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embeddings
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=1536

# Object Storage (MinIO S3-Compatible or Local)
STORAGE_TYPE=s3
STORAGE_LOCAL_DIR=./data/uploads
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=erp-documents
S3_REGION=us-east-1

# Observability (Optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
